---
import type { HTMLAttributes } from "astro/types";
import { SITE } from "@/config";
import type { Locale } from "@/utils/i18n";
import { copy } from "@/utils/i18n";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
  locale?: Locale;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, locale = "es", class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="flex flex-col gap-2 border-t border-border py-6 text-sm text-foreground/75 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="whitespace-nowrap">
      <span>{SITE.title}</span>
      <span aria-hidden="true"> · </span>
      <span>{copy[locale].personalWriting}</span>
    </div>
    <div class="whitespace-nowrap">© {currentYear}</div>
  </div>
</footer>
