---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";
import type { Locale } from "@/utils/i18n";
import { copy } from "@/utils/i18n";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

const { pathname } = Astro.url;
const { locale = "es", languageHref } = Astro.props as {
  locale?: Locale;
  languageHref?: string;
};
const text = copy[locale];
const root = locale === "es" ? "/es/" : "/";

const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header class="app-layout border-b border-border py-5">
  <div
    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <a href={root} class="text-xl font-semibold tracking-tight sm:text-2xl">
      {SITE.title}
    </a>

    <nav aria-label="Primary navigation">
      <ul
        class="flex flex-wrap items-center gap-x-5 gap-y-3 text-sm font-medium"
      >
        <li>
          <a href={root} class:list={{ "active-nav": currentPath === root.slice(0, -1) }}>{text.blog}</a
          >
        </li>
        <li>
          <a
            href="https://www.jaimechapinal.com"
            target="_blank"
            rel="noreferrer"
          >
            Website
          </a>
        </li>
        <li>
          <a href={locale === "es" ? "/es/rss.xml" : "/rss.xml"}>RSS</a>
        </li>
        <li><LanguageSwitcher {locale} targetHref={languageHref} /></li>
        {
          SITE.lightAndDarkMode && (
            <li>
              <button
                id="theme-btn"
                class="focus-outline relative size-8 hover:[&>svg]:stroke-accent"
                title="Toggles light & dark"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-locale-choice]").forEach(link => {
    link.addEventListener("click", () =>
      localStorage.setItem("preferredLocale", link.dataset.localeChoice ?? "en")
    );
  });
</script>
