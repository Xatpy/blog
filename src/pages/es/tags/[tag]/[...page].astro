---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { copy, getLocalePosts } from "@/utils/i18n";
import { SITE } from "@/config";
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = getLocalePosts(await getCollection("blog"), "es");
  return getUniqueTags(posts).flatMap(({ tag, tagName }) => paginate(getPostsByTag(posts, tag), { params: { tag }, props: { tagName }, pageSize: SITE.postPerPage }));
}
const { page, tagName } = Astro.props;
const text = copy.es;
---
<Layout title={`${text.tags}: ${tagName} | ${SITE.title}`} locale="es">
  <Header locale="es" />
  <Main pageTitle={`${text.tags}: ${tagName}`} pageDesc={text.tagDescription(tagName)}><ul>{page.data.map(data => <Card {...data} />)}</ul></Main>
  <Pagination {page} />
  <Footer locale="es" noMarginTop={page.lastPage > 1} />
</Layout>
