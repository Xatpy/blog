---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { copy, getLocalePosts } from "@/utils/i18n";
import { SITE } from "@/config";
const posts = getLocalePosts(await getCollection("blog"), "es");
const text = copy.es;
---
<Layout title={`${SITE.title} | Blog`} description={text.intro} locale="es" alternateURL={new URL("/", Astro.url).href}>
  <Header locale="es" />
  <main id="main-content" class="app-layout py-10">
    <section class="border-b border-border pb-6">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{text.blog}</h1>
      <p class="mt-4 max-w-2xl text-lg text-foreground/78">{text.intro}</p>
    </section>
    <section class="py-4"><ul>{getSortedPosts(posts).map(post => <Card variant="h3" {...post} />)}</ul></section>
  </main>
  <Footer locale="es" />
</Layout>
